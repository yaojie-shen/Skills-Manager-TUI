---
import { copy, installCommand, repository } from '../lib/content';
import CapturedTui from './CapturedTui.astro';
import HeroCapture from './HeroCapture.astro';
import ShellCode from './ShellCode.astro';
import BackToTop from './BackToTop.astro';
import '../styles/landing.css';
interface Props { locale: 'en' | 'zh-cn' }
const { locale } = Astro.props;
const t = copy[locale];
const zh = locale === 'zh-cn';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${zh ? 'zh-cn/' : ''}`;
const guide = (slug = '') => `${home}guide/${slug ? `${slug}/` : ''}`;
const alternate = `${base}/${zh ? '' : 'zh-cn/'}`;
---
<!doctype html><html lang={t.lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{t.title}</title><meta name="description" content={t.description}/><meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f2ec"/><meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0f10"/><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"/><script is:inline>(()=>{document.documentElement.classList.add('nav-ready');let t='';try{t=localStorage.getItem('starlight-theme')||''}catch{}if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.preference=t;document.documentElement.dataset.theme=t})()</script></head><body>
<a class="skip-link" href="#main">{t.skip}</a><div class="header-rule"><header class="header shell"><a class="wordmark" href={home}><span class="mark">&gt;_</span> Skills Manager</a><button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label={t.menu}><span aria-hidden="true"></span></button><nav id="site-nav" aria-label={t.navigation}><a href={guide()}>{t.guide}</a><a href={repository}>{t.source} ↗</a><a href={alternate}>{zh?'English':'简体中文'}</a><button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.theme} data-light={t.light} data-dark={t.dark}>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"/></svg>
</button></nav></header></div>
<main id="main">
<section class="hero shell field-grid"><div class="hero-copy"><p class="kicker">{t.eyebrow}</p><h1>{t.heroTitle}</h1><p class="lede">{t.intro}</p><div class="hero-actions"><a class="button primary" href="#install">{t.start} ↓</a></div></div><div class="hero-evidence"><HeroCapture/></div></section>
<section class="install-section shell field-grid field-section" id="install"><p class="margin-label"><b>INSTALL</b></p><div class="section-main"><ol class="runbook"><li><span>01</span><div><h3>{t.installHeading}</h3><div class="code-block"><button class="copy-code" type="button" data-command={installCommand} data-copy={t.copy} data-copied={t.copied} data-failed={t.copyFailed}>⧉ <span class="copy-label">{t.copy}</span></button><ShellCode code={installCommand}/><span class="copy-status" role="status" aria-live="polite"></span></div></div></li><li><span>02</span><div><h3>{t.initialize}</h3><div class="code-block"><button class="copy-code" type="button" data-command={`mkdir -p ~/.skills\nexport SKILLS_HOME="$HOME/.skills"\nskills init\nskills`} data-copy={t.copy} data-copied={t.copied} data-failed={t.copyFailed}>⧉ <span class="copy-label">{t.copy}</span></button><ShellCode code={`mkdir -p ~/.skills\nexport SKILLS_HOME="$HOME/.skills"\nskills init\nskills`}/><span class="copy-status" role="status" aria-live="polite"></span></div><p><code>{t.initEnv}</code> {t.initNote}</p></div></li></ol><div class="runbook-exit"><a href={guide('installation')}>{t.installationLink} →</a></div></div></section>
<CapturedTui locale={locale}/>
<section class="cli-section shell field-grid field-section"><p class="margin-label"><b>CLI</b></p><div class="section-main"><ol class="cli-commands">{t.steps.map(step=><li><p class="cli-index"><b>{step.id}</b><span>{step.phase}</span></p><div class="cli-copy"><h3>{step.title}</h3><p>{step.text}</p><a href={guide(step.slug)}>{step.link} →</a></div><ShellCode code={step.command} output={step.output}/></li>)}</ol></div></section>
</main><footer class="colophon shell"><p><b>{t.footerLine}</b></p><nav><a href={guide()}>{t.footerGuide}</a><a href={repository}>GitHub ↗</a><a href={`${repository}/blob/main/LICENSE`}>{t.license}</a><a class:list={['locale-link', !zh && 'locale-link-cjk']} href={alternate}>{zh?'English':'简体中文'}</a></nav></footer><BackToTop locale={locale}/>
<script>const themeToggle=document.querySelector<HTMLButtonElement>('#theme-toggle');function applyTheme(value:'light'|'dark'){document.documentElement.dataset.preference=value;document.documentElement.dataset.theme=value;if(themeToggle){const next=value==='light'?'dark':'light',label=themeToggle.dataset[next]||next;themeToggle.setAttribute('aria-label',label);themeToggle.title=label}}if(themeToggle){applyTheme(document.documentElement.dataset.theme==='dark'?'dark':'light');themeToggle.addEventListener('click',event=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark',x=event.clientX||innerWidth/2,y=event.clientY||0,r=Math.hypot(Math.max(x,innerWidth-x),Math.max(y,innerHeight-y)),reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,change=()=>{applyTheme(next);try{localStorage.setItem('starlight-theme',next)}catch{}};if(!document.startViewTransition||reduce){change();return}const transition=document.startViewTransition(change);transition.ready.then(()=>document.documentElement.animate({clipPath:[`circle(0 at ${x}px ${y}px)`,`circle(${r}px at ${x}px ${y}px)`]},{duration:520,easing:'cubic-bezier(.76,0,.24,1)',pseudoElement:'::view-transition-new(root)'})).catch(()=>{})})}const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle'),nav=document.querySelector<HTMLElement>('#site-nav'),header=document.querySelector<HTMLElement>('.header'),wordmark=document.querySelector<HTMLAnchorElement>('.wordmark'),mobile=matchMedia('(max-width: 800px)');if(toggle&&nav&&header){const setMenuOpen=(open:boolean,restoreFocus=false)=>{toggle.setAttribute('aria-expanded',String(open));nav.toggleAttribute('inert',mobile.matches&&!open);if(restoreFocus)toggle.focus()};setMenuOpen(false);toggle.addEventListener('click',()=>setMenuOpen(toggle.getAttribute('aria-expanded')!=='true'));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true')setMenuOpen(false,true)});document.addEventListener('click',event=>{const target=event.target;if(toggle.getAttribute('aria-expanded')==='true'&&target instanceof Node&&!header.contains(target))setMenuOpen(false)});nav.addEventListener('click',event=>{const target=event.target;if(target instanceof Element&&target.closest('a'))setMenuOpen(false)});mobile.addEventListener('change',event=>{const active=document.activeElement;setMenuOpen(false);if(event.matches&&active instanceof Node&&nav.contains(active))toggle.focus();else if(!event.matches&&active===toggle)wordmark?.focus()})}document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach(button=>button.addEventListener('click',async()=>{const label=button.querySelector<HTMLElement>('.copy-label'),status=button.parentElement?.querySelector<HTMLElement>('.copy-status'),idle=button.dataset.copy||'Copy';try{await navigator.clipboard.writeText(button.dataset.command||'');if(label)label.textContent=button.dataset.copied||'Copied';if(status)status.textContent=button.dataset.copied||'Copied'}catch{if(label)label.textContent=button.dataset.failed||idle;if(status)status.textContent=button.dataset.failed||''}window.setTimeout(()=>{if(label)label.textContent=idle;if(status)status.textContent=''},1600)}))</script></body></html>