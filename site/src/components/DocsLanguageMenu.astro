---
import { docsLanguageHref } from '../lib/docs-language-url.mjs';

const base = import.meta.env.BASE_URL;
const zh = Astro.locals.starlightRoute.locale === 'zh-cn';
const locale = zh ? 'zh-cn' : 'en';
const hrefFor = (targetLocale: 'en' | 'zh-cn') => docsLanguageHref({
  pathname: Astro.url.pathname,
  base,
  targetLocale,
  currentLocale: locale,
});
const current = zh ? '简体中文' : 'English';
const options = [
  { label: 'English', locale: 'en', href: hrefFor('en'), active: !zh },
  { label: '简体中文', locale: 'zh-cn', href: hrefFor('zh-cn'), active: zh },
];
---

<details class="docs-language-menu" data-base={base} data-locale={locale}>
  <summary aria-label={zh ? '切换语言' : 'Change language'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h9M8.5 3v2M6 9c1.4 2.8 3.5 4.8 6 6M11 7c-1 3.4-3.4 6.2-7 8M14 19l3.5-9 3.5 9M15.3 16h4.4"/></svg>
    <span>{current}</span>
    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
  </summary>
  <nav aria-label={zh ? '语言' : 'Language'}>
    {options.map(option => (
      <a href={option.href} data-locale={option.locale} aria-current={option.active ? 'page' : undefined}>
        <span aria-hidden="true">{option.active ? '✓' : ''}</span>{option.label}
      </a>
    ))}
  </nav>
</details>

<script>
  import { docsLanguageHref } from '../lib/docs-language-url.mjs';

  document.querySelectorAll<HTMLDetailsElement>('.docs-language-menu').forEach((menu) => {
    if (menu.dataset.ready) return;
    menu.dataset.ready = 'true';
    const { pathname, search, hash } = window.location;
    menu.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((link) => {
      link.setAttribute('href', docsLanguageHref({
        pathname,
        base: menu.dataset.base ?? '/',
        targetLocale: link.dataset.locale,
        currentLocale: menu.dataset.locale,
        search,
        hash,
      }));
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .docs-language-menu { position: relative; }
  .docs-language-menu summary {
    display: flex;
    min-width: 7.5rem;
    height: 2rem;
    padding-inline: .35rem;
    align-items: center;
    gap: .45rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .docs-language-menu summary::-webkit-details-marker { display: none; }
  .docs-language-menu summary:hover { color: var(--sl-color-accent); }
  .docs-language-menu svg { width: 1rem; height: 1rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .docs-language-menu .chevron { margin-left: auto; transition: transform 160ms ease; }
  .docs-language-menu[open] .chevron { transform: rotate(180deg); }
  .docs-language-menu nav {
    position: absolute;
    z-index: 20;
    top: calc(100% + .55rem);
    right: 0;
    display: grid;
    min-width: 9rem;
    padding: .35rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    box-shadow: .45rem .45rem 0 color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
  }
  .docs-language-menu a {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: .45rem;
    padding: .45rem .55rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .docs-language-menu a:hover,
  .docs-language-menu a[aria-current='page'] { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  @media (prefers-reduced-motion: reduce) { .docs-language-menu .chevron { transition: none; } }
</style>
