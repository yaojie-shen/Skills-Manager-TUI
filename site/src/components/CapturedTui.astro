---
import captures from '../generated/tui-captures.json';
import { copy, captureTabs } from '../lib/content';
import '../styles/captured-tui.css';
interface Props { locale: 'en' | 'zh-cn' }
const { locale } = Astro.props;
const c = copy[locale].capture;
const zh = locale === 'zh-cn';
const colors: Record<string, [string, string]> = {
  black: ['#111214', '#11161b'], red: ['#a5251c', '#ff7b72'], green: ['#25733a', '#7ee787'],
  yellow: ['#805600', '#e3b341'], blue: ['#315eaa', '#79c0ff'], magenta: ['#833a9c', '#d2a8ff'],
  cyan: ['#13747c', '#56d4dd'], gray: ['#5e615e', '#8c949e'], 'dark-gray': ['#5e615e', '#8c949e'],
  white: ['#111214', '#f0f2f6'], '#000000': ['#000000', '#000000'], '#f0f2f6': ['#111214', '#f0f2f6'],
  '#8c8c8c': ['#5e615e', '#8c8c8c'], '#5b8def': ['#315eaa', '#5b8def'], '#9b89ac': ['#6f5c80', '#9b89ac'],
  '#b87e54': ['#87532f', '#b87e54'], '#c678dd': ['#833a9c', '#c678dd'], '#e5a84b': ['#805600', '#e5a84b'],
};
const lightBackgrounds: Record<string, string> = { '#2c323c':'#e4e6e7', '#5b8def':'#b9cdf2', '#c678dd':'#dfb9e8', '#e5a84b':'#f1d59a', cyan:'#a8e3e7' };
const pillCap = /^[]+$/;
const color = (value: string, text = '') => value === 'reset' ? undefined : `light-dark(${pillCap.test(text) ? lightBackgrounds[value] ?? colors[value]?.[0] ?? value : colors[value]?.[0] ?? value},${colors[value]?.[1] ?? value})`;
const background = (value: string) => value === 'reset' ? undefined : `light-dark(${lightBackgrounds[value] ?? value},${colors[value]?.[1] ?? value})`;
---
<section class="capture-showcase shell field-grid field-section" data-capture-showcase>
  <p class="margin-label capture-register"><b>{c.label}</b></p>
  <div class="section-main capture-main">
    <div class="capture-stage">
      <div class="capture-selected" data-selected-frame>
        {captureTabs.map((name, index) => { const frame=captures.frames[name], item=c.screens[name]; return <figure class="capture-frame" data-frame={name} hidden={index !== 0} aria-label={`${c.names[name]}, ${index + 1} / 6. ${item.title}. ${item.text}`}>
          <div class="capture-terminal-scroller"><div class="capture-terminal-wrap"><pre class="capture-pre" aria-hidden="true">{frame.rows.map(row => <>{row.map(run => { const fg=color(run.fg,run.text), bg=background(run.bg); return <span class:list={run.mods} style={`${fg?`color:${fg};`:''}${bg?`background:${bg};`:''}`}>{run.text}</span> })}{'\n'}</>)}</pre><div class="capture-hotspots" data-hotspots={name} aria-hidden={index ? 'true' : 'false'} inert={index ? true : undefined}>{captureTabs.map(tab => <button type="button" data-tab={tab} aria-label={zh ? `显示 ${c.names[tab]} 画面` : `Show ${c.names[tab]} screen`}></button>)}</div></div></div>
          <figcaption class="capture-caption"><span class="capture-frame-number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span><div><p class="capture-label">SCREEN {String(index + 1).padStart(2,'0')} / 06 · {c.names[name]}</p><h3>{item.title}</h3><p>{item.text}</p></div></figcaption>
        </figure> })}
      </div>
      <nav class="capture-proof" aria-label={c.label} data-proof-grid>
        {captureTabs.map((name,index) => { const frame=captures.frames[name]; return <button type="button" data-proof={name} aria-current={index===0?'true':undefined} aria-label={zh ? `显示 ${c.names[name]} 画面，第 ${index+1} 帧，共 6 帧` : `Show ${c.names[name]} screen, frame ${index+1} of 6`}>
          <span class="proof-number">{String(index+1).padStart(2,'0')}</span><span class="proof-name">{c.names[name]}</span><span class="proof-preview" aria-hidden="true"><pre>{frame.rows.map(row => <>{row.map(run => { const fg=color(run.fg,run.text), bg=background(run.bg); return <span class:list={run.mods} style={`${fg?`color:${fg};`:''}${bg?`background:${bg};`:''}`}>{run.text}</span> })}{'\n'}</>)}</pre></span>
        </button> })}
      </nav>
      <p class="capture-status" aria-live="polite" aria-atomic="true">{c.names.library}: {c.screens.library.title}</p>
    </div>
  </div>
</section>
<script>
const root=document.querySelector<HTMLElement>('[data-capture-showcase]');
if(root){
  const names=['library','tags','presets','agents','repos','health'];
  const frames=[...root.querySelectorAll<HTMLElement>('[data-frame]')]; const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-proof]')]; const status=root.querySelector<HTMLElement>('.capture-status'); const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)'); let active=0;
  function select(name:string,focus=false,announce=true){const index=names.indexOf(name);if(index<0)return;const changed=index!==active;active=index;frames.forEach((frame,i)=>frame.hidden=i!==index);if(changed&&!reducedMotion.matches){const frame=frames[index];frame.classList.remove('is-entering');void frame.offsetWidth;frame.classList.add('is-entering')}buttons.forEach((button,i)=>i===index?button.setAttribute('aria-current','true'):button.removeAttribute('aria-current'));root!.querySelectorAll<HTMLElement>('[data-hotspots]').forEach((layer,i)=>{layer.toggleAttribute('inert',i!==index);layer.setAttribute('aria-hidden',String(i!==index))});if(status&&announce){const frame=frames[index];status.textContent=frame.getAttribute('aria-label')||name}if(focus)buttons[index]?.focus()}
  root.addEventListener('click',event=>{const button=(event.target as Element).closest<HTMLButtonElement>('[data-proof],[data-tab]');if(!button||!root.contains(button))return;select(button.dataset.proof||button.dataset.tab||'',button.hasAttribute('data-tab'))});
  buttons.forEach((button,index)=>button.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?names.length-1:(index+(event.key==='ArrowRight'?1:-1)+names.length)%names.length;select(names[next],true)}));
  select(names[0],false,false);
}
</script>
